{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "eslint.config.js"],
  // *.test.ts(x) and test/ are excluded from THIS program deliberately (see tsconfig.test.json).
  // @types/bun globally augments `fetch` (adds `.preconnect`), which then fails structural typing
  // against the plain `typeof fetch` annotations in src/integrations/supabase/*.ts — those files
  // build for the browser/Vercel, not Bun's runtime. Keeping test files in a separate program
  // keeps that global augmentation from ever reaching this one.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "test/**/*"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
